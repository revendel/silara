---
import { Image } from "astro:assets";
import silaraScanner from "../assets/images/silara_scanner.jpeg";
---

<div
  class="scanner-modal"
  id="scanner-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Silara QR code scanner to order"
  aria-hidden="true"
>
  <div class="scanner-modal__stage">
    <Image
      src={silaraScanner}
      alt="Silara QR code scanner to order"
      class="scanner-modal__img"
      id="scanner-modal-img"
      loading="lazy"
    />
  </div>
</div>

<div
  class="scanner-modal__close-wrap"
  id="scanner-modal-close-wrap"
  aria-hidden="true"
>
  <button
    class="scanner-modal__close-btn"
    id="scanner-modal-close"
    aria-label="Close modal"
  >
    Close
  </button>
</div>

<script>
  import { prefersReducedMotion, EASE_OUT, SPRING } from "../utils/animations";
  import { animate } from "motion";

  function bindScannerModal() {
    const modal = document.getElementById("scanner-modal");
    const closeWrap = document.getElementById("scanner-modal-close-wrap");
    const closeBtn = document.getElementById("scanner-modal-close");
    const qrImg = document.getElementById("scanner-modal-img");

    if (!modal || !closeWrap || !closeBtn) return;

    let activeTrigger: HTMLElement | null = null;

    function openModal(triggerEl?: HTMLElement | null) {
      activeTrigger = triggerEl || null;

      modal!.classList.add("is-open");
      modal!.setAttribute("aria-hidden", "false");
      closeWrap!.classList.add("is-visible");
      closeWrap!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      document.documentElement.setAttribute("data-lightbox-open", "true");

      const headerInner = document.querySelector(".site-header__inner");
      const headerChildren = headerInner
        ? (Array.from(headerInner.children) as HTMLElement[])
        : [];
      headerChildren.forEach((el, i) => {
        if (i > 0) el.style.visibility = "hidden";
      });

      const menuBtnBot = document.getElementById(
        "menu-toggle-bottom",
      ) as HTMLButtonElement | null;
      if (menuBtnBot) menuBtnBot.style.visibility = "hidden";

      if (qrImg && !prefersReducedMotion()) {
        animate(
          qrImg,
          { clipPath: ["inset(100% 0 0 0)", "inset(0% 0 0 0)"] },
          { duration: 0.65, easing: EASE_OUT },
        );
        animate(
          qrImg,
          { scale: [1.05, 1.0], y: [15, 0] },
          { duration: 0.9, easing: SPRING },
        );
      }
      closeBtn!.focus();
    }

    function closeModal() {
      modal!.classList.remove("is-open");
      modal!.setAttribute("aria-hidden", "true");
      closeWrap!.classList.remove("is-visible");
      closeWrap!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      document.documentElement.removeAttribute("data-lightbox-open");

      const headerInner = document.querySelector(".site-header__inner");
      const headerChildren = headerInner
        ? (Array.from(headerInner.children) as HTMLElement[])
        : [];
      headerChildren.forEach((el) => (el.style.visibility = ""));

      const menuBtnBot = document.getElementById(
        "menu-toggle-bottom",
      ) as HTMLButtonElement | null;
      if (menuBtnBot) menuBtnBot.style.visibility = "";

      if (activeTrigger) {
        activeTrigger.focus();
      }
    }

    const triggers = document.querySelectorAll<HTMLElement>(
      "[data-open-scanner], #footer-scan-open, #product-scan-open",
    );
    triggers.forEach((trigger) => {
      trigger.onclick = (e) => {
        e.preventDefault();
        openModal(trigger);
      };
    });

    closeBtn.onclick = closeModal;
    modal.onclick = (e) => {
      if (
        e.target !== modal &&
        e.target !== document.querySelector(".scanner-modal__stage")
      ) {
        return;
      }
      closeModal();
    };

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.classList.contains("is-open")) {
        closeModal();
      }
    });
  }

  document.addEventListener("astro:page-load", bindScannerModal);
</script>

<style>
  .scanner-modal {
    position: fixed;
    inset: 0;
    z-index: 70;
    background-color: rgba(0, 0, 0, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    pointer-events: none;
    transition:
      opacity 0.35s ease,
      backdrop-filter 0.5s ease,
      -webkit-backdrop-filter 0.5s ease;
  }

  .scanner-modal.is-open {
    opacity: 1;
    backdrop-filter: blur(var(--scale-4));
    -webkit-backdrop-filter: blur(var(--scale-4));
    pointer-events: auto;
  }

  .scanner-modal__stage {
    width: 100%;
    height: calc(100% - var(--scale-9));
    margin-top: var(--scale-9);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--scale-8);
  }

  .scanner-modal__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .scanner-modal__close-wrap {
    position: fixed;
    top: 0;
    right: var(--scale-8);
    height: var(--scale-9);
    display: flex;
    align-items: center;
    z-index: 85;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .scanner-modal__close-wrap.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .scanner-modal__close-btn {
    font-size: var(--scale-6);
    line-height: var(--scale-6);
    color: var(--base);
    background-color: var(--primary);
    padding: var(--scale-5) var(--scale-6);
    border-radius: var(--scale-9);
    white-space: nowrap;
    border: none;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .scanner-modal__close-btn:hover {
    opacity: 0.75;
  }
</style>
