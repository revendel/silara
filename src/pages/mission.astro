---
/**
 * Mission page — "Mission Desktop" (node 726:984)
 * Figma: outer frame is flex-col justify-between — header top, content+footer bottom.
 * In this project the footer is in BaseLayout, so we use margin-top:auto on
 * the inner content wrapper to push it flush to the footer bottom edge.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import missionHero from '../assets/images/mission-hero.webp';
---

<BaseLayout
  title="Our Mission | Clean Makhana Foxnut Brand"
  description="Silara Foods — on a mission to deliver clean, performance-driven makhana foods with uncompromising quality. Redefining healthy snacking with plant-based, nutrient-dense health food."
  keywords="makhana foxnut food brand, clean health food, plant based snacks India, healthy snacking, food mission, makhana foxnut nutrition"
>

  <section class="mission" aria-label="Our Mission">

    <!-- inner wrapper: margin-top:auto pushes it to the bottom of the section -->
    <div class="mission__inner">

      <!-- ── Text area: centered vertically in upper blank area ── -->
      <div class="mission__text-area">
        <div class="mission__text-row">

          <!-- Left: body paragraph, w=654px in Figma -->
          <p class="mission__paragraph">
            We craft foods for modern life — simple, nutritious, and uncompromising. By elevating foods with design and innovation, we transform healthy snacking into something cleaner, smarter, and more purposeful.
          </p>

          <!-- Right: title + sub-paragraph, flex-1 -->
          <div class="mission__title-block">
            <h2 class="mission__headline">Our Mission</h2>
            <p class="mission__subheadline">
              To deliver clean, performance-driven foods with uncompromising
              quality, redefining how the world snacks.
            </p>
          </div>

        </div>
      </div>

      <!-- ── Image (node 726:1122) h=526px ─────────────────────── -->
      <div class="mission__image-container" data-animate="mission-image">
        <Image
          src={missionHero}
          alt="Harvested makhana"
          class="mission__image"
          loading="lazy"
        />
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  import { springLift, imageReveal } from '../utils/animations';

  function initMissionAnimations() {
    const image   = document.querySelector<HTMLElement>('[data-animate="mission-image"]');
    const textRow = document.querySelector<HTMLElement>('.mission__text-row');

    if (!image) return;

    if (textRow) springLift(textRow);
    imageReveal(image);
  }

  document.addEventListener('astro:page-load', initMissionAnimations);
</script>

<style>
  /* ── Section: fills page__main flex column ───────────────────── */
  .mission {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  /*
   * Inner wrapper fills the entire section height.
   * flex-direction: column so text row sits above image.
   */
  .mission__inner {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 0 var(--scale-8);
  }

  /* ── Text area: vertically centers text row in upper blank area ── */
  .mission__text-area {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    width: 100%;
  }

  /* ── Text row: columns align at bottom baseline ─────────────────── */
  .mission__text-row {
    display: flex;
    align-items: flex-end;   /* Columns align bottom so both paragraphs share the exact same baseline */
    gap: var(--scale-10);    /* 144px horizontal gap between columns */
    width: 100%;
  }

  /* Left column: fixed width 654px from Figma */
  .mission__paragraph {
    flex: 0 0 auto;
    width: min(654px, 38%);
    font-size: var(--scale-6);   /* 21px */
    line-height: var(--scale-6);
    font-weight: 400;
  }

  /* Right column: flex-1, flex-col, gap-34px */
  .mission__title-block {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--scale-7);         /* 34px */
    min-width: 0;
  }

  .mission__headline {
    font-size: var(--scale-9);   /* 89px */
    line-height: var(--scale-9);
    font-weight: 400;
    text-transform: capitalize;
    letter-spacing: -0.04em;
  }

  .mission__subheadline {
    font-size: var(--scale-6);   /* 21px */
    line-height: var(--scale-6);
    font-weight: 400;
    max-width: 90%;
  }

  /* ── Image container: grows dynamically to fill bottom space ──── */
  .mission__image-container {
    flex: 1.1;
    min-height: 260px;
    overflow: hidden;
    position: relative;
  }

  .mission__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 29% 22%;
    max-width: none;
  }

  /* ── Fluid desktop (1024–1439px) ── */
  @media (min-width: 1024px) and (max-width: 1439px) {
    .mission__inner {
      padding: 0 var(--scale-6);
    }
    .mission__text-row {
      gap: var(--scale-8);
    }
    .mission__title-block {
      gap: var(--scale-5);
    }
  }

  /* ── Tablet (744 – 1023 px) ───────────────────────────────────── */
  @media (max-width: 1023px) {
    .mission__inner {
      margin-top: 0;   /* no push-down on tablet — natural top-to-bottom flow */
      padding: var(--scale-7) var(--scale-7) 0;
      gap: var(--scale-8);
    }

    .mission__text-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--scale-7);
    }

    /* Figma mobile order: headline → subheadline → paragraph → image */
    .mission__title-block { order: 1; }
    .mission__paragraph   { order: 2; width: 100%; }

    .mission__headline {
      font-size: var(--scale-8);  /* 55px */
    }

    .mission__image-container {
      height: 320px;
      min-height: 220px;
    }
  }

  /* ── Mobile (< 744 px) ───────────────────────────────────────── */
  @media (max-width: 743px) {
    .mission__inner {
      padding: var(--scale-6) var(--scale-6) 0;
      gap: var(--scale-7);
    }

    .mission__headline {
      font-size: clamp(var(--scale-7), 10vw, var(--scale-8));
    }

    .mission__image-container {
      height: 240px;
      min-height: 200px;
    }

    .mission__image {
      object-position: 90% center;
    }
  }
</style>
